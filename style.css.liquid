}

.state { fill:#D0D0D0; }
.borders { stroke:#FFFFFF; stroke-width:1; }

.ga, .in, .md, .ma, .mt, .ny, .nc, .oh, .ok, .pa, .tx, .vt, .va, .wi {
    fill: #4A90E2;
    cursor: pointer;
    transition: fill 0.2s ease;
}

.ga:hover, .in:hover, .md:hover, .ma:hover, .mt:hover, .ny:hover, .nc:hover,
.oh:hover, .ok:hover, .pa:hover, .tx:hover, .vt:hover, .va:hover, .wi:hover {
    fill: #FFD54F;
}

.state-organizers {
    padding: 4rem 1rem;
    text-align: center;
}

