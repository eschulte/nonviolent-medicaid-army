/* =========================================================
   GLOBAL TYPOGRAPHY + BASE
========================================================= */

body,
html {
    height: 100%;
}

body,
h1,
h2 {
    font-family: "Raleway", sans-serif;
}

body {
    font-weight: 500;
}

h1,
h2,
h3 {
    font-weight: 700;
}

h2 {
    font-size: 2.1rem;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    padding-top: 64px !important;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.12);
    text-decoration: underline;
    scroll-margin-top: 70px;
}

h3 {
    font-size: 1.45rem;
    font-weight: 700;
}

p {
    line-height: 2;
}

/* =========================================================
   HERO / BACKGROUNDS
========================================================= */

.bgimg,
.bgimg2 {
    min-height: 100%;
    background-position: center;
    background-size: cover;
}

.bgimg {
    background-image:
        linear-gradient(
            rgba(0, 0, 0, 0.2),
            rgba(0, 0, 0, 0.2)
        ),
        url('{{"/img/72286505_3307812459243757_5697027247718793216_o-crop.jpg" | url}}');
}

.bgimg2 {
    background-image:
        linear-gradient(
            rgba(0, 0, 0, 0.6),
            rgba(0, 0, 0, 0.6)
        ),
        url('{{"/img/zachary-keimig-s8ZTEbJNN7E-unsplash-prog.jpg" | url}}');
}

.w3-jumbo {
    text-shadow: 0 4px 18px rgba(0,0,0,0.6);
}

.w3-display-middle-high {
    position: absolute;
    top: 26%;
    left: 50%;
    transform: translate(-50%, -50%);
    -ms-transform: translate(-50%, -50%);
}

/* =========================================================
   LAYOUT + CONTENT CONTAINERS
========================================================= */

.main-content,
section {
    max-width: 1400px;
    margin: 0 auto;
    padding-left: 1rem;
    padding-right: 1rem;
}

section {
    background: rgba(255,255,255,0.02);
    border-radius: 12px;
    padding: 3rem 1rem;
    margin-bottom: 2rem;
}

.w3-content {
    padding-left: 0.5em;
}

.event-details {
    text-align: left;
}

.main-content ul li {
    margin-bottom: 0.85rem;
    line-height: 1.7;
}

/* =========================================================
   TOP NAVIGATION
========================================================= */

.topnav {
    position: fixed;
    top: 0;
    z-index: 9999;
    width: 100%;
    background: rgba(20,20,20,0.95);
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 12px rgba(0,0,0,0.35);
    padding: 6px 16px;
    min-height: auto;
}

.topnav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    min-height: 44px;
}

.topnav-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: white !important;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1;
}

.topnav-logo img {
    height: 48px;
    width: auto;
    display: block;
}

.desktop-title,
.mobile-title {
    display: inline;
    color: white !important;
    line-height: 1;
}

.topnav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
}

.topnav-links a {
    color: white !important;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1;
    padding: 2px 0;
    display: inline-block;
}

.topnav-links a:hover {
    color: #8ec5ff;
    text-decoration: underline;
}

.topnav-links a:focus,
.topnav-links a:active,
.topnav-links a:focus-visible {
    outline: none;
    box-shadow: none;
    text-decoration: underline;
    text-decoration-color: gray;
    text-underline-offset: 4px;
}

/* =========================================================
   FOCUS / TARGET STATES
========================================================= */

:target {
    animation: targetFade 2s ease;
    border-bottom: 2px solid gray;
    outline: none !important;
    box-shadow: none !important;
}

h1:focus,
h2:focus,
h3:focus,
section:focus,
div:focus,
a:focus {
    outline: none !important;
    box-shadow: none !important;
}

@keyframes targetFade {
    from {
        background-color: rgba(255,255,255,0.08);
    }
    to {
        background-color: transparent;
    }
}

/* =========================================================
   LINKS
========================================================= */

.main-content a {
    color: #8ec5ff;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
}

.main-content a:hover {
    color: #d7ecff;
}

/* =========================================================
   IMAGES
========================================================= */

.main-content img:not(.full) {
    border: 4px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    background: rgba(255,255,255,0.03);
}

@media (max-width:600px) {
    .main-content img {
        width: 80%;
        height: auto;
    }
}

@media (min-width:600px) {
    .main-content img:not(.full) {
        float: right;
        padding: 2em;
        width: 40%;
        height: auto;
    }

    .main-content img.full {
        margin: auto;
        display: block;
        padding: 2em;
        width: 80%;
        height: auto;
    }
}

/* =========================================================
   STATE MAP
========================================================= */

.state {
    fill: #D0D0D0;
}

.borders {
    stroke: #FFFFFF;
    stroke-width: 1;
}

.ga,
.in,
.md,
.ma,
.mt,
.ny,
.nc,
.oh,
.ok,
.pa,
.tx,
.vt,
.va,
.wi {
    fill: #6E8B5B;
    cursor: pointer;
    transition: fill 0.2s ease;
}

.ga:hover,
.in:hover,
.md:hover,
.ma:hover,
.mt:hover,
.ny:hover,
.nc:hover,
.oh:hover,
.ok:hover,
.pa:hover,
.tx:hover,
.vt:hover,
.va:hover,
.wi:hover {
    fill: #FFD54F;
}

.state-organizers {
    padding: 4rem 1rem;
    text-align: center;
}

/* =========================================================
   GALLERY
========================================================= */

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    padding: 2rem 0;
}

.gallery-item img {
    width: 100%;
    height: auto;
    display: block;
}

/* =========================================================
   UTILITIES
========================================================= */

.clamped {
    height: 400px;
    max-height: 400px;
    overflow-y: scroll;
    -ms-overflow-style: none;
    scrollbar-width: none;
}

.clamped::-webkit-scrollbar {
    display: none;
}

/* =========================================================
   LEGACY SLIDESHOW (kept temporarily in case referenced)
========================================================= */

.prev:hover,
.next:hover {
    background-color: rgba(0,0,0,0.8);
}

.text {
    color: #f2f2f2;
    font-size: 15px;
    padding: 8px 12px;
    position: absolute;
    bottom: 8px;
    width: 100%;
    text-align: center;
}

.numbertext {
    color: #f2f2f2;
    font-size: 12px;
    padding: 8px 12px;
    position: absolute;
    top: 0;
}

.dot {
    cursor: pointer;
    height: 15px;
    width: 15px;
    margin: 0 2px;
    background-color: #bbb;
    border-radius: 50%;
    display: inline-block;
    transition: background-color 0.6s ease;
}

.active,
.dot:hover {
    background-color: #717171;
}

.fade {
    -webkit-animation-name: fade;
    -webkit-animation-duration: 1.5s;
    animation-name: fade;
    animation-duration: 1.5s;
}

@-webkit-keyframes fade {
    from {
        opacity: .4;
    }
    to {
        opacity: 1;
    }
}

@keyframes fade {
    from {
        opacity: .4;
    }
    to {
        opacity: 1;
    }
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media only screen and (max-width: 300px) {
    .prev,
    .next,
    .text {
        font-size: 11px;
    }
}
