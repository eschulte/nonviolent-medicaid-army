body {
    font-weight: 500;
}

h1,h2,h3 {
    font-weight: 700;
}

.topnav {
    position: fixed;
    top: 0;
    z-index: 1000;
    background: rgba(20,20,20,0.95);
    padding: 0.5rem 1rem;
}

.topnav-links a:focus,
.topnav-links a:active {
    outline: none;
    box-shadow: none;
    text-decoration: underline;
    text-decoration-color: gray;
    text-underline-offset: 4px;
}

.topnav-links a:focus-visible {
    outline: none;
    box-shadow: none;
    text-decoration: underline;
    text-decoration-color: gray;
    text-underline-offset: 4px;
}

:target {
    animation: targetFade 2s ease;
    border-bottom: 2px solid gray;
}

@keyframes targetFade {
    from { background-color: rgba(255,255,255,0.08); }
    to { background-color: transparent; }
}

:target {
    outline: none !important;
    box-shadow: none !important;
}

h1:focus,
h2:focus,
h3:focus,
section:focus,
div:focus,
a:focus {
    outline: none !important;
    box-shadow: none !important;
}

